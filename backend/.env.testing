APP_ENV=testing
APP_KEY=base64:ubHQn3n0hHfeny4yjViYXb9WSipQYW0xwoo52nE4XN4=
APP_DEBUG=true
APP_URL=http://localhost

# Tests run against a real Postgres database — the schema uses
# Postgres-specific features (uuid + gen_random_uuid, pgvector,
# pg_advisory_xact_lock, ON CONFLICT, ALTER COLUMN ... USING) that
# SQLite cannot emulate. The josbin_pos_test database is created
# inside the same Postgres container as josbin_pos_demo and has the
# pgcrypto + vector extensions pre-installed.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=josbin_pos_test
DB_USERNAME=josbin_pos
DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
BCRYPT_ROUNDS=4

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# Stubbed values for tests that hit the AI / license layer — keep the
# code paths reachable without making real outbound calls.
OPENAI_API_KEY=test-key
ANTHROPIC_API_KEY=test-key
LICENSE_SERVER_URL=http://license-server.test
