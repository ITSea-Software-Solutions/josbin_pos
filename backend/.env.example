APP_NAME="Josbin POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Paramaribo
APP_URL=http://localhost:8080
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=josbin_pos
DB_USERNAME=josbin_pos
DB_PASSWORD=secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# ─── Cache / Sessions / Queues ────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
QUEUE_CONNECTION=redis

# ─── Broadcasting (Laravel Reverb) ────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=josbin_pos
REVERB_APP_KEY=josbin_pos-key
REVERB_APP_SECRET=josbin_pos-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend receives these for Laravel Echo
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@josbin.sr"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Exchange Rate API ────────────────────────────────────────────────────────
# Get free key at https://www.exchangerate-api.com (supports SRD)
# NOTE: Do NOT use Frankfurter/ECB — it does NOT support SRD
EXCHANGERATE_API_KEY=your_api_key_here
EXCHANGERATE_MARKUP_PCT=0

# ─── AI Layer ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── License Server ───────────────────────────────────────────────────────────
JOSBIN_POS_LICENSE_SERVER_URL=https://license.josbin.sr
JOSBIN_POS_INSTALLATION_KEY=
JOSBIN_POS_DEFAULT_BTW_RATE=10.00
JOSBIN_POS_INSTALLATION_TYPE=retail

# ─── API Sandbox ──────────────────────────────────────────────────────────────
# Set true ONLY on an isolated sandbox deployment for third-party API testing.
JOSBIN_POS_SANDBOX=false

# ─── Security ─────────────────────────────────────────────────────────────────
# Field-level encryption key for WBP-S personal data (customers table)
ENCRYPTION_FIELD_KEY=

# bcrypt cost factor — 12 gives ~250ms per hash (brute-force resistant)
BCRYPT_ROUNDS=12

# ─── Tenancy (stancl/tenancy) ─────────────────────────────────────────────────
TENANCY_DATABASE_AUTO_DELETE=false

# ─── Horizon ──────────────────────────────────────────────────────────────────
HORIZON_ENVIRONMENTS=local,production

# ─── Telescope (dev only — remove from production) ────────────────────────────
TELESCOPE_ENABLED=true
