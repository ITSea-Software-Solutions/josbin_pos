# ─────────────────────────────────────────────────────────────────────────────
# Deploy configuration for scripts/deploy-server.sh
#
# Copy to deploy.env (gitignored) and fill in per environment:
#     cp deploy.env.example deploy.env
#
# deploy.env holds ENVIRONMENT-SPECIFIC values (host, public URLs) so the same
# code deploys to test / staging / prod by swapping this one file — no code edits.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target server ─────────────────────────────────────────────────────────────
SSH_TARGET=root@142.93.88.143      # user@host with key-based SSH access
REMOTE_DIR=/var/www/html           # where the repo is cloned on the server
GIT_BRANCH=main

# ── Public endpoints (baked into the SPA builds) ──────────────────────────────
# API is reached same-origin via each SPA's nginx proxy, so this stays "/api".
VITE_API_URL=/api
# Where the "Open POS in browser" launcher points (POS web app).
#   IP+port (test):   http://142.93.88.143:8091
#   Domain (prod):    https://pos.yourdomain.com
VITE_POS_URL=http://142.93.88.143:8091

# ── Reverb (WebSocket) — used by the dashboard + POS for live updates ─────────
VITE_REVERB_HOST=142.93.88.143
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http             # use "https" behind TLS in prod
VITE_REVERB_APP_KEY=josbin_pos-key

# ── Health check ──────────────────────────────────────────────────────────────
APP_PORT=8080                       # backend API port on the server
