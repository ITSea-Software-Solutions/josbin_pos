{
  "name": "josbin_pos-frontend",
  "version": "1.7.1",
  "description": "Josbin POS — Electron POS & Admin Dashboard",
  "main": "dist-electron/main.js",
  "author": "Josbin POS Development Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:android": "vite build --config vite.config.ts && npx cap sync android && npx cap open android",
    "android:dev": "CAPACITOR_DEV=true vite build --config vite.config.ts && npx cap sync android && npx cap run android",
    "cap:sync": "npx cap sync",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capgo/capacitor-printer": "^8.0.0",
    "@ericblade/quagga2": "^1.8.4",
    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.0.0",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "jsbarcode": "^3.12.3",
    "laravel-echo": "^1.16.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.0.0",
    "recharts": "^2.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "tough-cookie": "^4.1.3",
    "tar": "^7.5.11",
    "cacache": "^18.0.0",
    "semver": "^7.5.4",
    "follow-redirects": "^1.15.12",
    "braces": "^3.0.3"
  },
  "build": {
    "appId": "sr.josbin_pos.pos",
    "productName": "Josbin POS",
    "copyright": "Copyright © 2025 Josbin POS",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  }
}
