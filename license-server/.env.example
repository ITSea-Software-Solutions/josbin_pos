APP_NAME="Josbin POS License Server"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Paramaribo
APP_URL=https://license.josbin-pos.sr

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=josbin_license
DB_USERNAME=josbin
DB_PASSWORD=

# For a quick local trial you can instead use SQLite:
# DB_CONNECTION=sqlite   (then: touch database/database.sqlite)

# API-only service — no sessions or queues needed.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# ── License server settings ─────────────────────────────────────────────────
# Secret key the developer company uses to reach the /api/admin/* endpoints.
# Sent by the admin tooling as the  X-Admin-Key  header. Keep this secret.
LICENSE_ADMIN_KEY=

# Human-readable prefix on every issued license key, e.g. JOSBIN-AB12-CD34-EF56
LICENSE_KEY_PREFIX=JOSBIN
